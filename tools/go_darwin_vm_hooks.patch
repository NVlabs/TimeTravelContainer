+++ b/src/runtime/ttc_vm_darwin.go
@@ -0,0 +1,93 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build darwin
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// ttcVMMemoryMutation is the allocation-free ABI between the Darwin runtime
+// VM primitives and an optional userspace secondary-MMU notifier. Keep this
+// layout synchronized with TTC's native hook definition.
+type ttcVMMemoryMutation struct {
+	version   uint32
+	operation uint16
+	phase     uint16
+	address   uintptr
+	length    uintptr
+	result    uintptr
+	prot      int32
+	flags     int32
+	fd        int32
+	errno     int32
+	offset    uint32
+	active    uint32
+}
+
+const (
+	ttcVMMemoryMutationVersion = 1
+
+	ttcVMMemoryMmap    uint16 = 1
+	ttcVMMemoryMunmap  uint16 = 2
+	ttcVMMemoryMadvise uint16 = 3
+
+	ttcVMMemoryBefore uint16 = 1
+	ttcVMMemoryAfter  uint16 = 2
+)
+
+var (
+	ttcVMMemoryEnsureHost uintptr
+	ttcVMMemoryCallback   uintptr
+)
+
+// ttcSetVMMemoryHooks installs TTC's process-wide Darwin VM notifier. The
+// callback uses the C ABI, accepts *ttcVMMemoryMutation, and returns zero on
+// success. Installation is idempotent because one process owns at most one
+// active Hypervisor.framework VM; the native callback owns VM-epoch changes.
+//
+//go:linkname ttcSetVMMemoryHooks
+//go:nosplit
+func ttcSetVMMemoryHooks(version uint32, ensureHost, callback uintptr) int32 {
+	if version != ttcVMMemoryMutationVersion {
+		return 1
+	}
+	if ensureHost == 0 || callback == 0 {
+		return 2
+	}
+	installed := atomic.Loaduintptr(&ttcVMMemoryCallback)
+	if installed != 0 {
+		if installed == callback && atomic.Loaduintptr(&ttcVMMemoryEnsureHost) == ensureHost {
+			return 0
+		}
+		return 3
+	}
+	atomic.Storeuintptr(&ttcVMMemoryEnsureHost, ensureHost)
+	atomic.Storeuintptr(&ttcVMMemoryCallback, callback)
+	return 0
+}
+
+// ttcVMMemoryCall may run without a valid G and while allocator locks are
+// held. It therefore performs only atomic loads and C-ABI calls on the
+// system stack. The first callback returns a resident Sentry continuation to
+// host EL0; the second performs the synchronous native MMU-notifier protocol.
+//
+//go:nosplit
+func ttcVMMemoryCall(mutation *ttcVMMemoryMutation) {
+	callback := atomic.Loaduintptr(&ttcVMMemoryCallback)
+	if callback == 0 {
+		return
+	}
+	ensureHost := atomic.Loaduintptr(&ttcVMMemoryEnsureHost)
+	if ensureHost == 0 {
+		throw("runtime: incomplete TTC VM memory hook")
+	}
+	asmcgocall(unsafe.Pointer(ensureHost), unsafe.Pointer(mutation))
+	if asmcgocall(unsafe.Pointer(callback), unsafe.Pointer(mutation)) != 0 {
+		throw("runtime: TTC VM memory hook failed")
+	}
+}
