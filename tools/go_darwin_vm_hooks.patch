+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//go:build darwin
+
+package runtime
+
+import (
+	"internal/runtime/atomic"
+	"unsafe"
+)
+
+// ttcVMMemoryMutation is the allocation-free ABI between the Darwin runtime
+// VM primitives and an optional userspace secondary-MMU notifier. Keep this
+// layout synchronized with TTC's native hook definition.
+type ttcVMMemoryMutation struct {
+	version   uint32
+	operation uint16
+	phase     uint16
+	address   uintptr
+	length    uintptr
+	result    uintptr
+	prot      int32
+	flags     int32
+	fd        int32
+	errno     int32
+	offset    uint32
+	active      uint32
+	disposition uint32
+}
+
+const (
+	ttcVMMemoryMutationVersion = 2
+
+	ttcVMMemoryMmap    uint16 = 1
+	ttcVMMemoryMunmap  uint16 = 2
+	ttcVMMemoryMadvise uint16 = 3
+	ttcVMMemoryStackSuspend uint16 = 4
+	ttcVMMemoryStackResume  uint16 = 5
+
+	ttcVMMemoryBefore uint16 = 1
+	ttcVMMemoryAfter  uint16 = 2
+
+	ttcVMMemoryProceed  uint32 = 0
+	ttcVMMemorySuppress uint32 = 1
+)
+
+var (
+	ttcVMMemoryEnsureHost  uintptr
+	ttcVMMemoryCallback    uintptr
+	ttcRuntimeTimeCallback uintptr
+)
+
+type ttcRuntimeTimeQuery struct {
+	version     uint32
+	clock       uint32
+	seconds     int64
+	nanoseconds int32
+	reserved    uint32
+}
+
+const (
+	ttcRuntimeTimeVersion   = 1
+	ttcRuntimeTimeWall      = 1
+	ttcRuntimeTimeMonotonic = 2
+)
+
+// ttcSetVMMemoryHooks installs TTC's process-wide Darwin VM notifier. The
+// callback uses the C ABI, accepts *ttcVMMemoryMutation, and returns zero on
+// success. Installation is idempotent because one process owns at most one
+// active Hypervisor.framework VM; the native callback owns VM-epoch changes.
+//
+//go:linkname ttcSetVMMemoryHooks
+//go:nosplit
+func ttcSetVMMemoryHooks(version uint32, ensureHost, callback uintptr) int32 {
+	if version != ttcVMMemoryMutationVersion {
+		return 1
+	}
+	if ensureHost == 0 || callback == 0 {
+		return 2
+	}
+	installed := atomic.Loaduintptr(&ttcVMMemoryCallback)
+	if installed != 0 {
+		if installed == callback && atomic.Loaduintptr(&ttcVMMemoryEnsureHost) == ensureHost {
+			return 0
+		}
+		return 3
+	}
+	atomic.Storeuintptr(&ttcVMMemoryEnsureHost, ensureHost)
+	atomic.Storeuintptr(&ttcVMMemoryCallback, callback)
+	return 0
+}
+
+// ttcVMMemoryCall may run without a valid G and while allocator locks are
+// held. It therefore performs only atomic loads and C-ABI calls on the
+// system stack. The first callback returns a resident Sentry continuation to
+// host EL0; the second performs the synchronous native MMU-notifier protocol.
+//
+//go:nosplit
+func ttcVMMemoryCall(mutation *ttcVMMemoryMutation) {
+	callback := atomic.Loaduintptr(&ttcVMMemoryCallback)
+	if callback == 0 {
+		return
+	}
+	ensureHost := atomic.Loaduintptr(&ttcVMMemoryEnsureHost)
+	if ensureHost == 0 {
+		throw("runtime: incomplete TTC VM memory hook")
+	}
+	asmcgocall(unsafe.Pointer(ensureHost), unsafe.Pointer(mutation))
+	if asmcgocall(unsafe.Pointer(callback), unsafe.Pointer(mutation)) != 0 {
+		throw("runtime: TTC VM memory hook failed")
+	}
+	if mutation.disposition > ttcVMMemorySuppress {
+		throw("runtime: invalid TTC VM memory disposition")
+	}
+}
+
+// ttcRuntimeEnsureHost establishes the execution-domain boundary before a
+// Darwin libc call. Entering an external text mapping from resident EL1 and
+// relying on the instruction-abort bridge would suspend asmcgocall halfway
+// through its stack transition; returning to the same Go continuation first
+// keeps the entire libcCall at host EL0.
+//
+//go:linkname ttcRuntimeEnsureHost
+//go:nosplit
+func ttcRuntimeEnsureHost() {
+	ensureHost := atomic.Loaduintptr(&ttcVMMemoryEnsureHost)
+	if ensureHost != 0 {
+		asmcgocall(unsafe.Pointer(ensureHost), nil)
+	}
+}
+
+// ttcVMMemoryStack publishes pthread stack lifetime transitions to TTC's
+// secondary MMU. It may run without a P and must remain allocation-free.
+//
+//go:nosplit
+func ttcVMMemoryStack(operation uint16) {
+	mp := getg().m
+	if mp == nil || mp.g0 == nil {
+		return
+	}
+	stack := mp.g0.stack
+	if stack.hi <= stack.lo {
+		return
+	}
+	mutation := ttcVMMemoryMutation{
+		version:   ttcVMMemoryMutationVersion,
+		operation: operation,
+		phase:     ttcVMMemoryBefore,
+		address:   stack.lo,
+		length:    stack.hi - stack.lo,
+	}
+	ttcVMMemoryCall(&mutation)
+}
+
+// ttcSetRuntimeTimeHook installs TTC's C-ABI clock callback. The callback
+// returns zero at host EL0, one after filling the query at guest EL1, and a
+// negative value for malformed state.
+//
+//go:linkname ttcSetRuntimeTimeHook
+//go:nosplit
+func ttcSetRuntimeTimeHook(version uint32, callback uintptr) int32 {
+	if version != ttcRuntimeTimeVersion {
+		return 1
+	}
+	if callback == 0 {
+		return 2
+	}
+	installed := atomic.Loaduintptr(&ttcRuntimeTimeCallback)
+	if installed != 0 {
+		if installed == callback {
+			return 0
+		}
+		return 3
+	}
+	atomic.Storeuintptr(&ttcRuntimeTimeCallback, callback)
+	return 0
+}
+
+//go:nosplit
+func ttcRuntimeTimeCall(clock uint32) (int64, int32, bool) {
+	callback := atomic.Loaduintptr(&ttcRuntimeTimeCallback)
+	if callback == 0 {
+		return 0, 0, false
+	}
+	query := ttcRuntimeTimeQuery{
+		version: ttcRuntimeTimeVersion,
+		clock:   clock,
+	}
+	status := asmcgocall(unsafe.Pointer(callback), unsafe.Pointer(&query))
+	if status < 0 {
+		throw("runtime: TTC time hook failed")
+	}
+	return query.seconds, query.nanoseconds, status == 1
+}
+
+// Owner-thread safe points. A Hypervisor.framework vCPU can be destroyed only
+// by the thread that created it, and not from a signal handler, while TTC
+// keeps a vCPU on its thread between the residencies of different tasks. To
+// retire such a vCPU, TTC makes a pending request visible through
+// *ttcSafePointPending, and every thread then calls ttcSafePointCallback
+// before its next libc call. The scheduler makes libc calls whenever it looks
+// for work, so a thread running Go code reaches one soon; ttcWakeIdleThreads
+// brings idle threads to one. A thread blocked in a system call reaches none,
+// so a thread that keeps a vCPU retires it, through ttcSyscallCallback, before
+// any system call that may not end; see ttcSetSyscallsEnd.
+const ttcThreadHooksVersion = 1
+
+var (
+	ttcSafePointCallback uintptr
+	ttcSyscallCallback   uintptr
+	ttcSafePointPending  uintptr // *uint32
+)
+
+// ttcSetThreadHooks installs TTC's C-ABI callbacks and the counter of pending
+// requests that enables the safe point. Each callback returns nonzero if it
+// retired the calling thread's vCPU. Like the other hooks, they are installed
+// once for the life of the process.
+//
+//go:linkname ttcSetThreadHooks
+//go:nosplit
+func ttcSetThreadHooks(version uint32, safePoint, beforeSyscall uintptr, pending *uint32) int32 {
+	if version != ttcThreadHooksVersion {
+		return 1
+	}
+	if safePoint == 0 || beforeSyscall == 0 || pending == nil {
+		return 2
+	}
+	installed := atomic.Loaduintptr(&ttcSafePointCallback)
+	if installed != 0 {
+		if installed == safePoint && atomic.Loaduintptr(&ttcSyscallCallback) == beforeSyscall &&
+			atomic.Loaduintptr(&ttcSafePointPending) == uintptr(unsafe.Pointer(pending)) {
+			return 0
+		}
+		return 3
+	}
+	atomic.Storeuintptr(&ttcSafePointPending, uintptr(unsafe.Pointer(pending)))
+	atomic.Storeuintptr(&ttcSyscallCallback, beforeSyscall)
+	atomic.Storeuintptr(&ttcSafePointCallback, safePoint)
+	return 0
+}
+
+// ttcRuntimeSafePoint calls TTC's safe-point callback while requests are
+// pending. It runs before a libc call, possibly without a P or with runtime
+// locks held, so the callback must not call back into Go. It is skipped in
+// signal handlers, where Hypervisor.framework may not be called.
+//
+//go:nosplit
+func ttcRuntimeSafePoint() {
+	pending := atomic.Loaduintptr(&ttcSafePointPending)
+	if pending == 0 || atomic.Load((*uint32)(unsafe.Pointer(pending))) == 0 {
+		return
+	}
+	gp := getg()
+	if gp == nil || gp.m == nil || gp == gp.m.gsignal {
+		return
+	}
+	if callback := atomic.Loaduintptr(&ttcSafePointCallback); callback != 0 &&
+		asmcgocall(unsafe.Pointer(callback), nil) != 0 {
+		gp.m.ttcParked = 0
+	}
+}
+
+// ttcSetThreadParked records whether the calling thread keeps a vCPU that no
+// residency uses.
+//
+//go:linkname ttcSetThreadParked
+//go:nosplit
+func ttcSetThreadParked(parked bool) {
+	if parked {
+		getg().m.ttcParked = 1
+	} else {
+		getg().m.ttcParked = 0
+	}
+}
+
+// ttcSetSyscallsEnd records whether the calling goroutine's system calls all
+// end, such as those of a goroutine that uses only non-blocking descriptors,
+// and returns the previous setting.
+//
+//go:linkname ttcSetSyscallsEnd
+//go:nosplit
+func ttcSetSyscallsEnd(end bool) bool {
+	gp := getg()
+	previous := gp.ttcSyscallsEnd
+	gp.ttcSyscallsEnd = end
+	return previous
+}
+
+// ttcRuntimeBeforeSyscall makes a thread that keeps a vCPU retire it before a
+// system call that may block the thread indefinitely, since only the thread
+// itself can. Goroutines whose system calls all end are exempt.
+//
+//go:nosplit
+func ttcRuntimeBeforeSyscall() {
+	gp := getg()
+	mp := gp.m
+	if mp.ttcParked == 0 || gp.ttcSyscallsEnd {
+		return
+	}
+	mp.ttcParked = 0
+	if callback := atomic.Loaduintptr(&ttcSyscallCallback); callback != 0 {
+		asmcgocall(unsafe.Pointer(callback), nil)
+	}
+}
+
+// ttcSemaCreated publishes that mp's semaphore can be signaled.
+//
+//go:nosplit
+func ttcSemaCreated(mp *m) {
+	atomic.Store(&mp.ttcSemaReady, 1)
+}
+
+// ttcWakeIdleThreads brings threads that sleep, in semasleep or in the
+// network poller, to a safe point without granting them anything. semasleep
+// waits until its count is positive, so a signal of its condition variable
+// alone makes it only wait again, which is a libc call; a woken poller looks
+// for work again. Like NumCgoCall, it walks allm without sched.lock: an M
+// that exits stays in memory.
+//
+//go:linkname ttcWakeIdleThreads
+func ttcWakeIdleThreads() {
+	for mp := (*m)(atomic.Loadp(unsafe.Pointer(&allm))); mp != nil; mp = mp.alllink {
+		if atomic.Load(&mp.ttcSemaReady) == 0 {
+			continue
+		}
+		pthread_mutex_lock(&mp.mutex)
+		pthread_cond_signal(&mp.cond)
+		pthread_mutex_unlock(&mp.mutex)
+	}
+	if netpollinited() {
+		netpollBreak()
+	}
+}
