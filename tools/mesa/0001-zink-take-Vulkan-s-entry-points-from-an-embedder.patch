SPDX-License-Identifier: MIT
---

diff --git a/src/gallium/drivers/zink/zink_public.h b/src/gallium/drivers/zink/zink_public.h
index c2fe873..cccceb6 100644
--- a/src/gallium/drivers/zink/zink_public.h
+++ b/src/gallium/drivers/zink/zink_public.h
@@ -29,6 +29,12 @@ struct renderonly;
 struct sw_winsys;
 struct pipe_screen_config;
 
+/* An embedder that links Vulkan, rather than loading it, sets these to
+ * Vulkan's vkGetInstanceProcAddr and vkGetDeviceProcAddr before it creates
+ * a screen, and Zink then calls Vulkan through them. */
+extern void *zink_vk_get_instance_proc_addr;
+extern void *zink_vk_get_device_proc_addr;
+
 struct pipe_screen *
 zink_create_screen(struct sw_winsys *winsys, const struct pipe_screen_config *config);
 
diff --git a/src/gallium/drivers/zink/zink_screen.c b/src/gallium/drivers/zink/zink_screen.c
index 6982927..517d355 100644
--- a/src/gallium/drivers/zink/zink_screen.c
+++ b/src/gallium/drivers/zink/zink_screen.c
@@ -62,6 +62,10 @@
 #endif
 #endif
 
+/* See zink_public.h. */
+void *zink_vk_get_instance_proc_addr;
+void *zink_vk_get_device_proc_addr;
+
 static int num_screens = 0;
 bool zink_tracing = false;
 
@@ -3422,15 +3426,20 @@ zink_internal_create_screen(const struct pipe_screen_config *config, int64_t dev
 
    u_trace_state_init();
 
-   screen->loader_lib = util_dl_open(VK_LIBNAME);
-   if (!screen->loader_lib) {
-      if (!screen->driver_name_is_inferred)
-         mesa_loge("ZINK: failed to load "VK_LIBNAME);
-      goto fail;
-   }
+   if (zink_vk_get_instance_proc_addr && zink_vk_get_device_proc_addr) {
+      screen->vk_GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)zink_vk_get_instance_proc_addr;
+      screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)zink_vk_get_device_proc_addr;
+   } else {
+      screen->loader_lib = util_dl_open(VK_LIBNAME);
+      if (!screen->loader_lib) {
+         if (!screen->driver_name_is_inferred)
+            mesa_loge("ZINK: failed to load "VK_LIBNAME);
+         goto fail;
+      }
 
-   screen->vk_GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetInstanceProcAddr");
-   screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetDeviceProcAddr");
+      screen->vk_GetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetInstanceProcAddr");
+      screen->vk_GetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)util_dl_get_proc_address(screen->loader_lib, "vkGetDeviceProcAddr");
+   }
    if (!screen->vk_GetInstanceProcAddr ||
        !screen->vk_GetDeviceProcAddr) {
       if (!screen->driver_name_is_inferred)
