From b9cca14b91424a4d945ea337edb5ebb14e7c29de Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Thu, 1 Oct 2026 01:01:14 +0800
Subject: [PATCH] vulkan: offer robustness2's nullDescriptor to guests

Zink, OpenGL on Vulkan, requires robustness2's nullDescriptor. MoltenVK
has VK_EXT_robustness2 but not nullDescriptor. Report it to guests, and
where the host's driver lacks it, leave it out of the host's device: the
guest's null descriptors reach the driver as they are, and MoltenVK binds
nil Metal resources for them.
---
 host/vulkan/vk_decoder_global_state.cpp | 38 +++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index fb37464..d495108 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -1567,6 +1567,16 @@ class VkDecoderGlobalState::Impl {
             ycbcrFeatures->samplerYcbcrConversion |= m_vkEmulation->isYcbcrEmulationEnabled();
         }
 
+        // Null descriptors, which Zink, OpenGL on Vulkan, requires. Where the
+        // host's driver lacks them, as MoltenVK does, the device takes the
+        // guest's null descriptors to its driver as they are: MoltenVK binds
+        // nil Metal resources for them.
+        VkPhysicalDeviceRobustness2FeaturesEXT* robustness2Features =
+            vk_find_struct<VkPhysicalDeviceRobustness2FeaturesEXT>(pFeatures);
+        if (robustness2Features != nullptr) {
+            robustness2Features->nullDescriptor = VK_TRUE;
+        }
+
         // Disable a set of Vulkan features if BypassVulkanDeviceFeatureOverrides is NOT enabled.
         if (!m_vkEmulation->getFeatures().BypassVulkanDeviceFeatureOverrides.enabled()) {
             VkPhysicalDeviceVulkan11Features* vk11Features =
@@ -2219,6 +2229,17 @@ class VkDecoderGlobalState::Impl {
             featuresToFilter.emplace_back(&features2->features);
         }
 
+        // Null descriptors that the host's driver lacks are not enabled in
+        // it (see on_vkGetPhysicalDeviceFeatures2).
+        {
+            VkPhysicalDeviceRobustness2FeaturesEXT* robustness2Features =
+                vk_find_struct<VkPhysicalDeviceRobustness2FeaturesEXT>(&createInfoFiltered);
+            if (robustness2Features != nullptr && robustness2Features->nullDescriptor &&
+                !hostSupportsNullDescriptor(physicalDevice, vk)) {
+                robustness2Features->nullDescriptor = VK_FALSE;
+            }
+        }
+
         // Handle protected memory related features
         {
             // b/329845987, protected memory is not supported on emulators.
@@ -10569,6 +10590,23 @@ class VkDecoderGlobalState::Impl {
         return false;
     }
 
+    // hostSupportsNullDescriptor returns whether the host's driver has
+    // robustness2's nullDescriptor.
+    bool hostSupportsNullDescriptor(VkPhysicalDevice physicalDevice, VulkanDispatch* vk) {
+        if (!vk->vkGetPhysicalDeviceFeatures2) {
+            return false;
+        }
+        VkPhysicalDeviceRobustness2FeaturesEXT robustness2Features = {
+            VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ROBUSTNESS_2_FEATURES_EXT,
+        };
+        VkPhysicalDeviceFeatures2 features2 = {
+            VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+            &robustness2Features,
+        };
+        vk->vkGetPhysicalDeviceFeatures2(physicalDevice, &features2);
+        return robustness2Features.nullDescriptor == VK_TRUE;
+    }
+
     bool needEmulatedProtectedMemory(VkPhysicalDevice /*physicalDevice*/, VulkanDispatch* /*vk*/) EXCLUDES(mMutex) {
         return m_vkEmulation->isProtectedMemoryEmulationEnabled();
     }
