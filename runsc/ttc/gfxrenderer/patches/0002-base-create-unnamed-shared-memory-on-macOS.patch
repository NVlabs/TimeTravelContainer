From dade6d4717b9c36a52948a9438da3f10631c9e23 Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Wed, 30 Sep 2026 19:25:50 +0800
Subject: [PATCH] base: create unnamed shared memory on macOS

macOS's POSIX shared memory names are global to the user, and
SharedMemory::create opened an existing object of its name instead of
failing. gfxstream's names repeat in every process: ring blobs are named
after their resource ID, and Vulkan's host-visible memory after a
per-process counter. So two renderers of one user, such as two VMs'
or two sandboxes', shared their command rings and memory: each guest could
read and write the other's, and their rings deadlocked.

On macOS, create now makes an object under a unique, unguessable name,
exclusively, and unlinks the name at once, so that the object is shared
only through its descriptor, as gfxstream shares it. Linux's memfd_create
already makes unnamed objects.
---
 common/base/SharedMemory_posix.cpp    | 35 ++++++++++++++++++++++++++-
 common/base/SharedMemory_unittest.cpp | 25 +++++++++++++++++++
 2 files changed, 59 insertions(+), 1 deletion(-)

diff --git a/common/base/SharedMemory_posix.cpp b/common/base/SharedMemory_posix.cpp
index efd971c..8774892 100644
--- a/common/base/SharedMemory_posix.cpp
+++ b/common/base/SharedMemory_posix.cpp
@@ -13,6 +13,8 @@
 // limitations under the License.
 
 #include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
 #include <fcntl.h>
 #include <sys/mman.h>
 #include <sys/stat.h>
@@ -46,6 +48,33 @@
 namespace gfxstream {
 namespace base {
 
+#if defined(__APPLE__)
+// createUnnamedShm creates POSIX shared memory that no other process can open.
+// macOS's shared memory names are global to the user, and callers' names,
+// such as "gfxstream-ringblob-shmem-<resource ID>", repeat in every process:
+// two renderers would open, and share, one object. So the object gets a name
+// that is unique and unguessable, exclusively, and loses it at once. It is
+// shared only through its descriptor.
+static int createUnnamedShm(int oflag, int mode, std::string* name) {
+    for (int attempt = 0; attempt < 16; ++attempt) {
+        // Names are at most 31 characters (PSHMNAMLEN).
+        char buf[32];
+        snprintf(buf, sizeof(buf), "/gfxs.%08x%08x", arc4random(), arc4random());
+        int fd = ::shm_open(buf, oflag | O_EXCL, mode);
+        if (fd >= 0) {
+            ::shm_unlink(buf);
+            *name = buf;
+            return fd;
+        }
+        if (errno != EEXIST) {
+            return -1;
+        }
+    }
+    errno = EEXIST;
+    return -1;
+}
+#endif
+
 SharedMemory::SharedMemory(const std::string& name, size_t size) {
     mSize = ALIGN(size, getpagesize());
     const std::string& kFileUri = "file://";
@@ -115,7 +144,11 @@ int SharedMemory::openInternal(int oflag, int mode, bool doMapping) {
     struct stat sb;
     if (mShareType == ShareType::SHARED_MEMORY) {
 #if defined(__APPLE__)
-        mFd = ::shm_open(mName.c_str(), oflag, mode);
+        if (oflag & O_CREAT) {
+            mFd = createUnnamedShm(oflag, mode, &mName);
+        } else {
+            mFd = ::shm_open(mName.c_str(), oflag, mode);
+        }
 #elif defined(HAVE_MEMFD_CREATE)
         mFd = memfd_create(mName.c_str(), MFD_CLOEXEC | MFD_ALLOW_SEALING);
 #else
diff --git a/common/base/SharedMemory_unittest.cpp b/common/base/SharedMemory_unittest.cpp
index 8cfd6d9..75700a0 100644
--- a/common/base/SharedMemory_unittest.cpp
+++ b/common/base/SharedMemory_unittest.cpp
@@ -137,6 +137,15 @@ TEST(SharedMemory, CannotOpenTwice) {
     base::SharedMemory mReader(unique_name, message.size());
     int err = mWriter.create(user_read_only);
     ASSERT_EQ(0, err);
+#if defined(__APPLE__)
+    // Created shared memory has no name to open on macOS.
+    err = mReader.open(SharedMemory::AccessMode::READ_ONLY);
+    ASSERT_NE(0, err);
+
+    // Second create should fail..
+    err = mWriter.create(user_read_only);
+    ASSERT_NE(0, err);
+#else
     err = mReader.open(SharedMemory::AccessMode::READ_ONLY);
     ASSERT_EQ(0, err);
 
@@ -147,7 +156,23 @@ TEST(SharedMemory, CannotOpenTwice) {
     // Second open should fail..
     err = mReader.open(SharedMemory::AccessMode::READ_ONLY);
     ASSERT_NE(0, err);
+#endif
+}
+
+#if defined(__APPLE__)
+// Creators of shared memory of one name get objects of their own, as
+// renderers in separate processes, whose names repeat, must.
+TEST(SharedMemory, CreatorsOfOneNameDoNotShare) {
+    const mode_t user_read_write = 0600;
+    std::string name = "tst_21654869810548";
+    base::SharedMemory first(name, 4096);
+    base::SharedMemory second(name, 4096);
+    ASSERT_EQ(0, first.create(user_read_write));
+    ASSERT_EQ(0, second.create(user_read_write));
+    static_cast<char*>(first.get())[0] = 1;
+    ASSERT_EQ(0, static_cast<char*>(second.get())[0]);
 }
+#endif
 
 TEST(SharedMemory, CreateNoMapping) {
     const mode_t user_read_write = 0755;
-- 
2.50.1 (Apple Git-155)

