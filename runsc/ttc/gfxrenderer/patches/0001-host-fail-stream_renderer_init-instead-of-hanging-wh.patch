From 59308ac9b9569336ba59120124e3a1bd087fa1da Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Wed, 30 Sep 2026 18:08:52 +0800
Subject: [PATCH] host: fail stream_renderer_init instead of hanging when the
 renderer does not start

GetRenderer waited for a frame buffer after InitRenderer failed, which
will never exist, so stream_renderer_init never returned.
---
 host/virtio_gpu_gfxstream_renderer.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/host/virtio_gpu_gfxstream_renderer.cpp b/host/virtio_gpu_gfxstream_renderer.cpp
index f974dad..9865ff6 100644
--- a/host/virtio_gpu_gfxstream_renderer.cpp
+++ b/host/virtio_gpu_gfxstream_renderer.cpp
@@ -322,6 +322,10 @@ RendererPtr GetRenderer(uint32_t displayWidth,
     } else {
         renderer = InitRenderer(displayWidth, displayHeight, rendererFlags, features);
     }
+    if (!renderer) {
+        // The frame buffer will never be initialized.
+        return nullptr;
+    }
 
     FrameBuffer::waitUntilInitialized();
 
