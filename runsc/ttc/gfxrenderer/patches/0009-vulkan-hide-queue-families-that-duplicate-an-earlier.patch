From afa0d894d91abf6239e1b803debb209c777d7c4a Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Thu, 1 Oct 2026 05:34:07 +0800
Subject: [PATCH] vulkan: hide queue families that duplicate an earlier one

MoltenVK exposes four general queue families, each with one queue that
does graphics, compute, and transfer. Guests that find several graphics
families may wait for a window surface to pick one: ANGLE's Vulkan
backend, as Android's SurfaceFlinger uses it, then defers creating its
device, but initializes its memory allocator with the device it has yet
to create, and crashes.

Offer guests the host's queue families less the trailing ones that
duplicate an earlier family: MoltenVK's device then has one. The families
that remain keep the host's indices, so nothing else maps them.
---
 .../vk_emulated_physical_device_queue.cpp     | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/host/vulkan/vk_emulated_physical_device_queue.cpp b/host/vulkan/vk_emulated_physical_device_queue.cpp
index 3a2305f..e05f40f 100644
--- a/host/vulkan/vk_emulated_physical_device_queue.cpp
+++ b/host/vulkan/vk_emulated_physical_device_queue.cpp
@@ -25,6 +25,33 @@ EmulatedPhysicalDeviceQueueProperties::EmulatedPhysicalDeviceQueueProperties(
     const std::vector<VkQueueFamilyProperties>& host, const gfxstream::host::FeatureSet& features) {
     mQueueFamilyProperties = host;
 
+    // Hide trailing families that duplicate an earlier one, as MoltenVK's
+    // three extra general families do: some guests take a device with
+    // several graphics families as one that needs a window surface to pick
+    // a family, and ANGLE's Vulkan backend then uses a device that it has yet
+    // to create. Families that remain keep the host's indices.
+    auto same = [](const VkQueueFamilyProperties& a, const VkQueueFamilyProperties& b) {
+        return a.queueFlags == b.queueFlags && a.queueCount == b.queueCount &&
+               a.timestampValidBits == b.timestampValidBits &&
+               a.minImageTransferGranularity.width == b.minImageTransferGranularity.width &&
+               a.minImageTransferGranularity.height == b.minImageTransferGranularity.height &&
+               a.minImageTransferGranularity.depth == b.minImageTransferGranularity.depth;
+    };
+    while (mQueueFamilyProperties.size() > 1) {
+        const VkQueueFamilyProperties& last = mQueueFamilyProperties.back();
+        bool duplicate = false;
+        for (size_t i = 0; i + 1 < mQueueFamilyProperties.size(); i++) {
+            if (same(mQueueFamilyProperties[i], last)) {
+                duplicate = true;
+                break;
+            }
+        }
+        if (!duplicate) {
+            break;
+        }
+        mQueueFamilyProperties.pop_back();
+    }
+
     // Override queueCount for the virtual queue to be provided with device creations
     mHasVirtualGraphicsQueue = features.VulkanVirtualQueue.enabled();
     if (mHasVirtualGraphicsQueue) {
-- 
