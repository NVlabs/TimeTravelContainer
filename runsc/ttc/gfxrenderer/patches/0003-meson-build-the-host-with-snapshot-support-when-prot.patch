From 185f051b35f0e7263fd094ac4fb7e6cc7e1e7440 Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Wed, 30 Sep 2026 20:05:20 +0800
Subject: [PATCH 3/4] meson: build the host with snapshot support when protobuf
 is found

stream_renderer_snapshot and stream_renderer_restore need the virtio-gpu
frontend's snapshot support, GFXSTREAM_BUILD_WITH_SNAPSHOT_FRONTEND_SUPPORT,
whose state is protocol buffers, and only Android.bp built it. The meson
build now generates the frontend's protocol buffers and builds the support
when protobuf is found, or fails without it if -Dsnapshots=enabled.
---
 host/meson.build  | 19 +++++++++++++++++++
 meson_options.txt |  6 ++++++
 2 files changed, 25 insertions(+)

diff --git a/host/meson.build b/host/meson.build
index 1e8875a..fb03c1d 100644
--- a/host/meson.build
+++ b/host/meson.build
@@ -166,6 +166,25 @@ elif host_machine.system() == 'qnx'
   ]
 endif
 
+# Snapshots of the virtio-gpu frontend's state (stream_renderer_snapshot and
+# stream_renderer_restore) are protocol buffers.
+dep_protobuf = dependency('protobuf', required: get_option('snapshots'))
+if dep_protobuf.found()
+  prog_protoc = find_program('protoc')
+  gen_protobuf = generator(prog_protoc,
+    output: ['@BASENAME@.pb.cc', '@BASENAME@.pb.h'],
+    arguments: ['--proto_path=@CURRENT_SOURCE_DIR@', '--cpp_out=@BUILD_DIR@', '@INPUT@'])
+  files_lib_gfxstream_backend += gen_protobuf.process(
+    'virtio_gpu_context_snapshot.proto',
+    'virtio_gpu_frontend_snapshot.proto',
+    'virtio_gpu_resource_snapshot.proto',
+    'virtio_gpu_ring_blob_snapshot.proto',
+    'virtio_gpu_timelines_snapshot.proto',
+  )
+  gfxstream_backend_cpp_args += '-DGFXSTREAM_BUILD_WITH_SNAPSHOT_FRONTEND_SUPPORT=1'
+  deps_gfxstream_backend += dep_protobuf
+endif
+
 gfxstream_backend = library(
   'gfxstream_backend',
   files_lib_gfxstream_backend,
diff --git a/meson_options.txt b/meson_options.txt
index b86a617..4a8e8f1 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -722,6 +722,12 @@ option(
   description : 'The logging level of gfxstream'
 )
 option('qnx_target', type : 'string', value : '', description : 'QNX SDP target path')
+option(
+  'snapshots',
+  type : 'feature',
+  value : 'auto',
+  description : 'Build the host renderer with snapshot support, which needs protobuf'
+)
 option(
   'gfxstream-build',
   type : 'combo',
-- 
