From 63644e5177cda30a65d2317a05a78b60f9487909 Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Thu, 1 Oct 2026 02:01:44 +0800
Subject: [PATCH] vulkan: offer the host's extensions that Vulkan 1.1 and 1.2
 promoted

The device offered only the extensions that the codegen lists, which lacks
extensions that Vulkan 1.1 and 1.2 promoted to core, such as
VK_KHR_16bit_storage, although they bring no command and no struct but
core ones, which the codegen supports. Applications enable them by name:
llama.cpp's Vulkan backend always enables VK_KHR_16bit_storage, and its
vkCreateDevice failed with VK_ERROR_EXTENSION_NOT_PRESENT. Offer them where
the host's driver does.
---
 host/vulkan/vk_decoder_global_state.cpp | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/host/vulkan/vk_decoder_global_state.cpp b/host/vulkan/vk_decoder_global_state.cpp
index c54b4dc..51b127d 100644
--- a/host/vulkan/vk_decoder_global_state.cpp
+++ b/host/vulkan/vk_decoder_global_state.cpp
@@ -163,6 +163,23 @@ static constexpr const char* const kEmulatedDeviceExtensions[] = {
 #endif
 };
 
+// Device extensions that Vulkan 1.1 and 1.2 promoted, which bring no command
+// and no struct but core ones. The codegen, which supports the core ones,
+// does not list them, and applications enable them by name, as llama.cpp's
+// Vulkan backend does VK_KHR_16bit_storage: the device offers them where the
+// host's driver does.
+static constexpr const char* const kPromotedDeviceExtensions[] = {
+    "VK_KHR_16bit_storage",
+    "VK_KHR_8bit_storage",
+    "VK_KHR_driver_properties",
+    "VK_KHR_shader_atomic_int64",
+    "VK_KHR_shader_draw_parameters",
+    "VK_KHR_shader_float_controls",
+    "VK_KHR_spirv_1_4",
+    "VK_KHR_uniform_buffer_standard_layout",
+    "VK_KHR_variable_pointers",
+};
+
 // A list of instance extensions that should not be passed to the host driver.
 // On older pre-1.1 Vulkan platforms, gfxstream emulates these features.
 static constexpr const char* const kEmulatedInstanceExtensions[] = {
@@ -2085,6 +2102,11 @@ class VkDecoderGlobalState::Impl {
         properties.erase(
             std::remove_if(properties.begin(), properties.end(),
                            [&](const VkExtensionProperties& extension) {
+                               for (const char* promoted : kPromotedDeviceExtensions) {
+                                   if (strcmp(extension.extensionName, promoted) == 0) {
+                                       return false;
+                                   }
+                               }
                                return supportedDeviceExtensions.find(extension.extensionName) ==
                                       supportedDeviceExtensions.end();
                            }),
-- 
