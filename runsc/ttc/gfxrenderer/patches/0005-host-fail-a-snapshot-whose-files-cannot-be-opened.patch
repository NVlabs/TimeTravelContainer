From 463ab3517a9ed84aae9ac0b1484a46378370af6f Mon Sep 17 00:00:00 2001
From: Zizheng Guo <zizhengg@nvidia.com>
Date: Wed, 30 Sep 2026 20:18:39 +0800
Subject: [PATCH] host: fail a snapshot whose files cannot be opened

The frontend's snapshot and restore wrote and read their files through
StdioStreams of fopen's result, unchecked, so a directory that the
renderer could not write, or a missing file, crashed the renderer in
flockfile. A renderer that takes a snapshot for a fork is the source's,
whose guest keeps using it: the snapshot must fail, not the renderer.
---
 host/virtio_gpu_frontend.cpp | 32 ++++++++++++++++++++++++++++----
 1 file changed, 28 insertions(+), 4 deletions(-)

diff --git a/host/virtio_gpu_frontend.cpp b/host/virtio_gpu_frontend.cpp
index 1b0ff75..5a64d31 100644
--- a/host/virtio_gpu_frontend.cpp
+++ b/host/virtio_gpu_frontend.cpp
@@ -1061,7 +1061,13 @@ int VirtioGpuFrontend::snapshotRenderer(const char* directory) {
     const std::filesystem::path snapshotDirectory = std::string(directory);
     const std::filesystem::path snapshotPath = snapshotDirectory / kSnapshotBasenameRenderer;
 
-    StdioStream stream(fopen(snapshotPath.string().c_str(), "wb"), StdioStream::kOwner);
+    FILE* snapshotFile = fopen(snapshotPath.string().c_str(), "wb");
+    if (snapshotFile == nullptr) {
+        GFXSTREAM_ERROR("Failed to save snapshot: failed to open %s: %s",
+                        snapshotPath.string().c_str(), strerror(errno));
+        return -EIO;
+    }
+    StdioStream stream(snapshotFile, StdioStream::kOwner);
 
     if (!mRenderer) {
         GFXSTREAM_ERROR("Failed to snapshot renderer: renderer not available.");
@@ -1126,7 +1132,13 @@ int VirtioGpuFrontend::snapshotAsg(const char* directory) {
     const std::filesystem::path snapshotDirectory = std::string(directory);
     const std::filesystem::path snapshotPath = snapshotDirectory / kSnapshotBasenameAsg;
 
-    StdioStream stream(fopen(snapshotPath.string().c_str(), "wb"), StdioStream::kOwner);
+    FILE* snapshotFile = fopen(snapshotPath.string().c_str(), "wb");
+    if (snapshotFile == nullptr) {
+        GFXSTREAM_ERROR("Failed to save snapshot: failed to open %s: %s",
+                        snapshotPath.string().c_str(), strerror(errno));
+        return -EIO;
+    }
+    StdioStream stream(snapshotFile, StdioStream::kOwner);
 
     int ret = gfxstream_address_space_save_memory_state(&stream);
     if (ret) {
@@ -1178,7 +1190,13 @@ int VirtioGpuFrontend::restoreRenderer(const char* directory) {
     const std::filesystem::path snapshotDirectory = std::string(directory);
     const std::filesystem::path snapshotPath = snapshotDirectory / kSnapshotBasenameRenderer;
 
-    StdioStream stream(fopen(snapshotPath.string().c_str(), "rb"), StdioStream::kOwner);
+    FILE* snapshotFile = fopen(snapshotPath.string().c_str(), "rb");
+    if (snapshotFile == nullptr) {
+        GFXSTREAM_ERROR("Failed to load snapshot: failed to open %s: %s",
+                        snapshotPath.string().c_str(), strerror(errno));
+        return -EIO;
+    }
+    StdioStream stream(snapshotFile, StdioStream::kOwner);
 
     if (!mRenderer) {
         GFXSTREAM_ERROR("Failed to restore renderer: renderer not available.");
@@ -1243,7 +1261,13 @@ int VirtioGpuFrontend::restoreAsg(const char* directory) {
     const std::filesystem::path snapshotDirectory = std::string(directory);
     const std::filesystem::path snapshotPath = snapshotDirectory / kSnapshotBasenameAsg;
 
-    StdioStream stream(fopen(snapshotPath.string().c_str(), "rb"), StdioStream::kOwner);
+    FILE* snapshotFile = fopen(snapshotPath.string().c_str(), "rb");
+    if (snapshotFile == nullptr) {
+        GFXSTREAM_ERROR("Failed to load snapshot: failed to open %s: %s",
+                        snapshotPath.string().c_str(), strerror(errno));
+        return -EIO;
+    }
+    StdioStream stream(snapshotFile, StdioStream::kOwner);
 
     // Gather external memory info that the ASG device needs to reload.
     AddressSpaceDeviceLoadResources asgLoadResources;
-- 
