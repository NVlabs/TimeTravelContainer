From: Zizheng Guo <zizhengg@nvidia.com>
Subject: [PATCH] gfxstream: build the Android driver with the NDK alone

The guest driver's Android build requires AOSP's libraries (libbase,
AEMU's, minigbm's headers), which only AOSP's build provides, for the
goldfish path: the emulator's gralloc, pipe, and sync device, and render
control. On virtio-gpu, as Cuttlefish's and TTC's GPUs are, the driver
needs none of them.

Builds with Mesa's Android stubs (-Dandroid-stub=true), which the NDK
alone makes, now build that driver: without goldfish, with the Linux
driver's stubs for render control and the QEMU pipe, with minigbm's
gralloc (whose handle's header, Android 14's, comes with it), and with
bionic's system properties rather than libbase's or libcutils'. The
Android stubs gain libnativewindow's functions that the driver calls.
---
diff --git a/src/android_stub/nativewindow_stub.cpp b/src/android_stub/nativewindow_stub.cpp
index 277b5d5..a0b06fd 100644
--- a/src/android_stub/nativewindow_stub.cpp
+++ b/src/android_stub/nativewindow_stub.cpp
@@ -44,6 +44,25 @@ AHardwareBuffer_getNativeHandle(const AHardwareBuffer *buffer)
    return NULL;
 }
 
+int
+AHardwareBuffer_lock(AHardwareBuffer *buffer, uint64_t usage, int32_t fence,
+                     const ARect *rect, void **outVirtualAddress)
+{
+   return 0;
+}
+
+int
+AHardwareBuffer_unlock(AHardwareBuffer *buffer, int32_t *fence)
+{
+   return 0;
+}
+
+int
+AHardwareBuffer_getId(const AHardwareBuffer *buffer, uint64_t *outId)
+{
+   return 0;
+}
+
 void
 ANativeWindow_acquire(ANativeWindow *window)
 {
diff --git a/src/gfxstream/guest/android/ANativeWindowAndroid.cpp b/src/gfxstream/guest/android/ANativeWindowAndroid.cpp
index e0b168d..70b229a 100644
--- a/src/gfxstream/guest/android/ANativeWindowAndroid.cpp
+++ b/src/gfxstream/guest/android/ANativeWindowAndroid.cpp
@@ -10,6 +10,15 @@
 #if DETECT_OS_ANDROID
 #include <android/native_window.h>
 #include <system/window.h>
+
+// libnativewindow's LL-NDK functions (vndk/window.h), which Mesa's Android
+// stub headers don't declare with system/window.h.
+extern "C" {
+int ANativeWindow_dequeueBuffer(ANativeWindow* window, ANativeWindowBuffer** buffer, int* fenceFd);
+int ANativeWindow_queueBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer, int fenceFd);
+int ANativeWindow_setUsage(ANativeWindow* window, uint64_t usage);
+int ANativeWindow_cancelBuffer(ANativeWindow* window, ANativeWindowBuffer* buffer, int fenceFd);
+}
 #endif  // DETECT_OS_ANDROID
 
 namespace gfxstream {
diff --git a/src/gfxstream/guest/android/GfxStreamGralloc.cpp b/src/gfxstream/guest/android/GfxStreamGralloc.cpp
index d8e1fff..f76082b 100644
--- a/src/gfxstream/guest/android/GfxStreamGralloc.cpp
+++ b/src/gfxstream/guest/android/GfxStreamGralloc.cpp
@@ -11,19 +11,25 @@
 
 #include <string>
 
-#include "GrallocGoldfish.h"
+#include <sys/system_properties.h>
+
 #include "GrallocMinigbm.h"
-#include "android-base/properties.h"
+#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
+#include "GrallocGoldfish.h"
+#endif
 
 namespace gfxstream {
 
 Gralloc* createPlatformGralloc(int32_t descriptor) {
-    const std::string value = android::base::GetProperty("ro.hardware.gralloc", "");
-    if (value == "minigbm") {
-        auto gralloc = new MinigbmGralloc(descriptor);
-        return gralloc;
+#if GFXSTREAM_ENABLE_GUEST_GOLDFISH
+    char value[PROP_VALUE_MAX] = "";
+    __system_property_get("ro.hardware.gralloc", value);
+    if (std::string(value) != "minigbm") {
+        return new GoldfishGralloc();
     }
-    return new GoldfishGralloc();
+#endif
+    // Without goldfish, buffers are minigbm's, on virtio-gpu.
+    return new MinigbmGralloc(descriptor);
 }
 
 }  // namespace gfxstream
diff --git a/src/gfxstream/guest/android/meson.build b/src/gfxstream/guest/android/meson.build
index 9d171ed..dff1d5a 100644
--- a/src/gfxstream/guest/android/meson.build
+++ b/src/gfxstream/guest/android/meson.build
@@ -2,8 +2,16 @@
 # SPDX-License-Identifier: MIT
 
 inc_gfxstream_android = include_directories('include')
-deps_gfxstream_android = [dependency('android-utils')]
-if host_machine.system() == 'android'
+deps_gfxstream_android = []
+if host_machine.system() == 'android' and not with_gfxstream_guest_aosp
+    files_gfxstream_android = files(
+        'ANativeWindowAndroid.cpp',
+        'GfxStreamGralloc.cpp',
+        'GrallocMinigbm.cpp',
+    )
+    inc_gfxstream_android = include_directories('include', 'ndk-include')
+elif host_machine.system() == 'android'
+    deps_gfxstream_android += [dependency('android-utils')]
     dep_android_minigbm_headers = dependency('android-minigbm-headers')
     dep_android_nativebase_headers = dependency('android-nativebase-headers')
     dep_android_aemu_gralloc_headers = dependency('android-aemu-gralloc-headers')
diff --git a/src/gfxstream/guest/android/ndk-include/cros_gralloc/cros_gralloc_handle.h b/src/gfxstream/guest/android/ndk-include/cros_gralloc/cros_gralloc_handle.h
new file mode 100644
index 0000000..2d0e1ac
--- /dev/null
+++ b/src/gfxstream/guest/android/ndk-include/cros_gralloc/cros_gralloc_handle.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright 2016 The Chromium OS Authors. All rights reserved.
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file.
+ */
+
+#ifndef CROS_GRALLOC_HANDLE_H
+#define CROS_GRALLOC_HANDLE_H
+
+#include <cstdint>
+#include <cutils/native_handle.h>
+
+#define DRV_MAX_PLANES 4
+#define DRV_MAX_FDS (DRV_MAX_PLANES + 1)
+
+struct cros_gralloc_handle : public native_handle_t {
+	/*
+	 * File descriptors must immediately follow the native_handle_t base and used file
+	 * descriptors must be packed at the beginning of this array to work with
+	 * native_handle_clone().
+	 *
+	 * This field contains 'num_planes' plane file descriptors followed by an optional metadata
+	 * reserved region file descriptor if 'reserved_region_size' is greater than zero.
+	 */
+	int32_t fds[DRV_MAX_FDS];
+	uint32_t strides[DRV_MAX_PLANES];
+	uint32_t offsets[DRV_MAX_PLANES];
+	uint32_t sizes[DRV_MAX_PLANES];
+	uint32_t id;
+	uint32_t width;
+	uint32_t height;
+	uint32_t format; /* DRM format */
+	uint32_t tiling;
+	uint64_t format_modifier;
+	uint64_t use_flags; /* Buffer creation flags */
+	uint32_t magic;
+	uint32_t pixel_stride;
+	int32_t droid_format;
+	int32_t usage; /* Android usage. */
+	uint32_t num_planes;
+	uint64_t reserved_region_size;
+	uint64_t total_size; /* Total allocation size */
+} __attribute__((packed));
+
+typedef const struct cros_gralloc_handle *cros_gralloc_handle_t;
+
+#endif
diff --git a/src/gfxstream/guest/connection-manager/meson.build b/src/gfxstream/guest/connection-manager/meson.build
index df2a49b..8774484 100644
--- a/src/gfxstream/guest/connection-manager/meson.build
+++ b/src/gfxstream/guest/connection-manager/meson.build
@@ -9,7 +9,7 @@ files_libconnection_manager = files(
     'VirtioGpuPipeStream.cpp',
 )
 
-if with_platform_android
+if with_gfxstream_guest_aosp
   files_libconnection_manager += files('QemuPipeStream.cpp')
 else
   files_libconnection_manager += files('QemuPipeStreamStub.cpp')
diff --git a/src/gfxstream/guest/meson.build b/src/gfxstream/guest/meson.build
index c54f57b..c2b8d90 100644
--- a/src/gfxstream/guest/meson.build
+++ b/src/gfxstream/guest/meson.build
@@ -49,7 +49,10 @@ if with_gfxstream_emulated_android
     gfxstream_guest_args += '-DEND2END_TESTS'
 endif
 
-if with_platform_android
+# Builds with the NDK alone (android-stub) lack AOSP's goldfish libraries:
+# they drive virtio-gpu, as the Linux guest does.
+with_gfxstream_guest_aosp = with_platform_android and not with_android_stub
+if with_gfxstream_guest_aosp
     gfxstream_guest_args += '-DGFXSTREAM_ENABLE_GUEST_GOLDFISH'
 endif
 
@@ -81,7 +84,11 @@ dep_android_aemu_gl_codec = null_dep
 dep_android_aemu_qemupipe = null_dep
 dep_android_aemu_ringbuffer = null_dep
 dep_android_aemu_rc_encoder = null_dep
-if with_platform_android or with_gfxstream_emulated_android
+if with_platform_android and not with_gfxstream_guest_aosp
+    # AOSP's build defines ANDROID; the NDK's compilers define __ANDROID__.
+    gfxstream_guest_args += ['-DVK_USE_PLATFORM_ANDROID_KHR', '-DANDROID']
+    gfxstream_deps += dep_android
+elif with_platform_android or with_gfxstream_emulated_android
     gfxstream_guest_args += '-DVK_USE_PLATFORM_ANDROID_KHR'
     dep_android_base = dependency('android-base')
     dep_android_arect = dependency('android-arect')
diff --git a/src/gfxstream/guest/vulkan/meson.build b/src/gfxstream/guest/vulkan/meson.build
index e38c96d..9789dc8 100644
--- a/src/gfxstream/guest/vulkan/meson.build
+++ b/src/gfxstream/guest/vulkan/meson.build
@@ -1,7 +1,7 @@
 # Copyright 2022 Android Open Source Project
 # SPDX-License-Identifier: MIT
 
-if with_platform_android
+if with_gfxstream_guest_aosp
     dep_gfxstream_stubs = null_dep
 else
     subdir('stubs')
diff --git a/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl b/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
index 3499964..14cfcff 100644
--- a/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
+++ b/src/gfxstream/guest/vulkan_enc/VkEncoder.cpp.inl
@@ -8,7 +8,7 @@ static uint32_t sFeatureBits = 0;
 static constexpr uint32_t kWatchdogBufferMax = 1'000;
 
 #if DETECT_OS_ANDROID
-#include <cutils/properties.h>
+#include <sys/system_properties.h>
 #endif
 
 class VkEncoder::Impl {
@@ -18,8 +18,8 @@ class VkEncoder::Impl {
         m_stream.incStreamRef();
 #if DETECT_OS_ANDROID
         const char* emuVkLogEncodesPropName = "qemu.vk.log";
-        char encodeProp[PROPERTY_VALUE_MAX];
-        if (property_get(emuVkLogEncodesPropName, encodeProp, nullptr) > 0) {
+        char encodeProp[PROP_VALUE_MAX];
+        if (__system_property_get(emuVkLogEncodesPropName, encodeProp) > 0) {
             m_logEncodes = atoi(encodeProp) > 0;
         }
 #endif
